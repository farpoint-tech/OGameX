# =============================================================================
# OGameX PRODUCTION environment template.
#
# Copy this file to .env and replace EVERY value marked CHANGE_ME_* /
# GENERATE_* before starting the containers. Do not deploy with the
# placeholder values: the application should fail to connect rather than
# run with known-default credentials.
#
# Production checklist (see README.md "Production checklist" for details):
#   [ ] APP_ENV=production and APP_DEBUG=false
#   [ ] APP_KEY generated (php artisan key:generate, done automatically by
#       the Docker entrypoint if left empty)
#   [ ] Unique DB password for the application user (not root!)
#   [ ] Unique DB root password (used by the bundled MariaDB container)
#   [ ] SESSION_SECURE_COOKIE=true (requires HTTPS)
#   [ ] Unique REVERB_APP_KEY / REVERB_APP_SECRET
#   [ ] Real mail settings
# =============================================================================

APP_NAME=OGameX
APP_ENV=production
APP_KEY=
# NEVER set APP_DEBUG=true in production: it leaks configuration, secrets and
# stack traces to visitors.
APP_DEBUG=false
APP_LOG_LEVEL=error
APP_URL=https://example.com

# Optional: change Docker exposed ports (host:container mapping)
# HTTP_PORT=80
# HTTPS_PORT=443
# PHPMYADMIN_PORT=8080

# Debugbar must remain disabled in production.
DEBUGBAR_ENABLED=false

DISCORD_ALERT_WEBHOOK=
# Set to true to send exception alerts to Discord while in the production environment.
SEND_DISCORD_IN_PRODUCTION=false

# -----------------------------------------------------------------------------
# Database (MySQL/MariaDB required in production; SQLite is dev/test only).
# Use a dedicated application user with privileges limited to this database.
# Do NOT connect the application as root.
# Generate passwords with e.g.: openssl rand -base64 24
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=ogamex-db
DB_PORT=3306
DB_DATABASE=ogamex_production
DB_USERNAME=ogamex_app
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
# Root password for the bundled MariaDB container (docker-compose.prod.yml).
# Only used for container provisioning, never by the application itself.
DB_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION

BROADCAST_CONNECTION=reverb
CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=720
# Only send session cookies over HTTPS. Keep enabled in production.
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database

# Rate limiting for game endpoints (galaxy, fleet, espionage, phalanx, etc.).
# THROTTLE_GAME_BY: "user" (per authenticated user, IP fallback) or "ip".
THROTTLE_GAME_PER_MINUTE=120
THROTTLE_GAME_BY=user

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls

# -----------------------------------------------------------------------------
# Reverb (WebSockets). The development template ships publicly known values --
# generate unique random values for production:
#   REVERB_APP_KEY:    openssl rand -hex 16
#   REVERB_APP_SECRET: openssl rand -hex 32
# -----------------------------------------------------------------------------
REVERB_APP_ID=ogamex
REVERB_APP_KEY=GENERATE_NEW_KEY
REVERB_APP_SECRET=GENERATE_NEW_SECRET
REVERB_HOST=example.com
REVERB_PORT=443
REVERB_SCHEME=https

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8090
